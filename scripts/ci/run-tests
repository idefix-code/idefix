#!/usr/bin/env bash

# Use an array to keep each CMake option as a separate argument
CMAKE_OPTS=()

# load ICC compiler env
if [ "$IDEFIX_COMPILER" == icc ]; then
    source /opt/intel/oneapi/setvars.sh
fi

# load CUDA compiler env
if [ "$IDEFIX_COMPILER" == cuda ]; then
    CMAKE_OPTS+=(
        -DCMAKE_CXX_COMPILER=clang++-21
        -DCMAKE_C_COMPILER=clang-21
        -DKokkos_ARCH_AMPERE86=ON
    )
fi

# enable bash features
set -ue

# load python venv if present
if [ -d .venv ]; then
    source .venv/bin/activate
fi

# to get access to idefix ./pytools/ module in python code
if [[ -v PYTHONPATH ]]; then
    export PYTHONPATH="${PWD}:${PYTHONPATH}"
else
    export PYTHONPATH="${PWD}"
fi

#load module environement
source /etc/profile.d/modules.sh

# load openmpi env
module load openmpi

# run the test the old way (still possible up to now)
#cd "$1"
#./testme.py "${@:2}"

# run the test the new way (via pytest)
if [ ${#CMAKE_OPTS[@]} -gt 0 ]; then
    # pass cmake options as a single argument so pytest does not parse -D* flags
    CMAKE_OPTS_STR="${CMAKE_OPTS[*]}"
    ./test.py -subdir "$@" -cmake-opts "${CMAKE_OPTS_STR}"
else
    ./test.py -subdir "$@"
fi
