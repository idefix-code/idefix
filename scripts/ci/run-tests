#!/usr/bin/env bash

# Use an array to keep each CMake option as a separate argument
CMAKE_OPTS=""

#load module environement
source /etc/profile.d/modules.sh

# load openmpi env
module load openmpi

# load ICC compiler env
if [ "$IDEFIX_COMPILER" == icc ]; then
    source /opt/intel/oneapi/setvars.sh
fi

# load CUDA compiler env
if [ "$IDEFIX_COMPILER" == cuda ]; then
    CMAKE_OPTS="-DCMAKE_CXX_COMPILER=clang++-21 -DCMAKE_C_COMPILER=clang-21 -DKokkos_ARCH_AMPERE86=ON"
    module unload cuda
    module load cuda/12.8
    export CXXFLAGS=-Wno-unknown-cuda-version
fi

# enable bash features
set -ue

# load python venv if present
if [ -d .venv ]; then
    source .venv/bin/activate
fi

# to get access to idefix ./pytools/ module in python code
if [[ -v PYTHONPATH ]]; then
    export PYTHONPATH="${PWD}:${PYTHONPATH}"
else
    export PYTHONPATH="${PWD}"
fi


# run the test the old way (still possible up to now)
#cd "$1"
#./testme.py "${@:2}"

# run the test the new way (via pytest)
if [[ -n "$CMAKE_OPTS" ]]; then
    ./test.py -subdir "$@" -cmake "$CMAKE_OPTS" -compileJobs 16
else
    ./test.py -subdir "$@" -compileJobs 16
fi
